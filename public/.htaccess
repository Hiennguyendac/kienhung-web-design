<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_URI} ^/tin-tuc/ha-tang-va-do-thi-xanh-tao-cu-huých-cho-bat-dong-san-nha-trang$ [NC]
  RewriteRule ^ /tin-tuc/ha-tang-va-do-thi-xanh-tao-cu-huych-cho-bat-dong-san-nha-trang [R=301,L]
  RewriteCond %{REQUEST_URI} ^/tin-tuc/ha-tang-va-do-thi-xanh-tao-cu-hu%C3%BDch-cho-bat-dong-san-nha-trang$ [NC]
  RewriteRule ^ /tin-tuc/ha-tang-va-do-thi-xanh-tao-cu-huych-cho-bat-dong-san-nha-trang [R=301,L]
  RewriteCond %{REQUEST_URI} ^/tin-tuc/aws-bat-tay-superblocks-dua-vibe-coding-vao-private-cloud-cuoc-dua-hạ-tang-ai-doanh-nghiep$ [NC]
  RewriteRule ^ /tin-tuc/aws-bat-tay-superblocks-dua-vibe-coding-vao-private-cloud-cuoc-dua-ha-tang-ai-doanh-nghiep [R=301,L]
  RewriteCond %{REQUEST_URI} ^/tin-tuc/aws-bat-tay-superblocks-dua-vibe-coding-vao-private-cloud-cuoc-dua-h%E1%BA%A1-tang-ai-doanh-nghiep$ [NC]
  RewriteRule ^ /tin-tuc/aws-bat-tay-superblocks-dua-vibe-coding-vao-private-cloud-cuoc-dua-ha-tang-ai-doanh-nghiep [R=301,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # JS/CSS có hash trong tên - cache dai han
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Font
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Anh
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # HTML - KHONG cache dai han, luon kiem tra ban moi
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
